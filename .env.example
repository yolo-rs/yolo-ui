# ==============================================================================
# YOLO Sovereign Fleet - Environment Template (.env.example)
# Copy to `.env` (gitignored). Supports Keyless Google AI Ultra + ADC + Tokens.
# ==============================================================================

# 1. Context7 & Exa Search MCP
CONTEXT7_API_KEY=
CTX7_API_KEY=
CONTEXT7_BASE_URL=https://mcp.context7.com/mcp
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai

# 2. Vercel CLI & Vercel Labs (fx / native / AI Gateway)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
FX_PERMISSION_MODE=yolo
FX_AUTO_UPGRADE=0
FX_SOUND=0

# 3. Google Stitch MCP & SDK (@google/stitch-sdk v0.4.0)
STITCH_MCP_URL=https://stitch.googleapis.com/mcp
STITCH_PROJECT_ID=
STITCH_HOST=https://stitch.googleapis.com
STITCH_API_KEY=
STITCH_ACCESS_TOKEN=

# 4. Figma Developer Platform & Official Figma MCP Server (v2.2.174)
FIGMA_MCP_URL=https://mcp.figma.com/mcp
FIGMA_LOCAL_MCP_URL=http://127.0.0.1:3845/mcp
FIGMA_ACCESS_TOKEN=
FIGMA_PERSONAL_ACCESS_TOKEN=
FIGMA_FILE_KEY=
FIGMA_TEAM_ID=

# 5. Google AI Ultra Subscription Bridge (Keyless Default) & Gemini / Vertex AI
YOLO_AGY=1
YOLO_AGY_PROFILE=
YOLO_GOOGLE_ACCOUNT=
YOLO_APP_SERVER_ADDR=127.0.0.1:1338
YOLO_APP_SERVER_URL=http://127.0.0.1:1338
YOLO_ONE_PORT=4000
YOLO_ONE_URL=http://127.0.0.1:4000/v1
GOOGLE_CLOUD_PROJECT=
CLOUDSDK_CORE_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# 6. Anthropic / Claude Service Account
ANTHROPIC_API_KEY=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_SERVICE_ACCOUNT_NAME=yolo
ANTHROPIC_WORKSPACE_ID=

# 7. Package Registries, GitHub & Sovereign Cloud
NPM_TOKEN=
CARGO_REGISTRY_TOKEN=
GITHUB_TOKEN=
GH_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NEON_API_KEY=
NEON_ORG_ID=
SUPABASE_ACCESS_TOKEN=
