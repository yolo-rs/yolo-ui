{
  "name": "@yolo-rs/yolo-ui",
  "version": "0.8.0-alpha.3",
  "description": "Yolo UI (yolo-rs/yolo-ui) Unified Multi-Engine Fullstack Rust + Bun UI Framework Monorepo (Dioxus 0.8 + Blitz + GPUI + Iced/Cosmic + Egui + GTK4 + Qt6 + Tauri v3 + React 19/Expo + 8 Theme Presets)",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.4-canary.1",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yolo-rs/yolo-ui.git"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "@yolo-rs/ui-mcp": "workspace:*",
    "@yolo-rs/ui-plugin": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "workspaces": [
    "apps/locally-uncensored",
    "apps/yolo-browser-workbench",
    "apps/spacedrive/apps/*",
    "apps/spacedrive",
    "apps/spacedrive/docs",
    "apps/spacedrive/packages/*",
    "apps/spacedrive/scripts",
    "packages/extension",
    "packages/playwright-tests",
    "packages/yolo-ui-plugin",
    "packages/yolo-ui-mcp",
    "packages/bun-tauri",
    "packages/yolo-shadcn-bun",
    "packages/yolo-react",
    "packages/yolo-fullstack"
  ],
  "scripts": {
    "ui": "bun scripts/ui.ts",
    "lu:dev": "bun --cwd=apps/locally-uncensored run dev",
    "lu:build": "bun --cwd=apps/locally-uncensored run build",
    "lu:tauri:dev": "bun --cwd=apps/locally-uncensored run tauri:dev",
    "lu:tauri:build": "bun --cwd=apps/locally-uncensored run tauri:build",
    "sd:dev": "bun --cwd=apps/spacedrive/apps/tauri run dev",
    "sd:build": "bun --cwd=apps/spacedrive/apps/tauri run build",
    "sd:web:dev": "bun --cwd=apps/spacedrive/apps/web run dev",
    "sd:web:build": "bun --cwd=apps/spacedrive/apps/web run build",
    "sd:server": "cargo run -p sd-server --",
    "sd:typecheck": "bun --cwd=apps/spacedrive run typecheck",
    "sd:docs:dev": "bun --cwd=apps/spacedrive/docs run dev",
    "sd:docs:build": "bun --cwd=apps/spacedrive/docs run build",
    "sd:tauri:dev": "bun --cwd=apps/spacedrive/apps/tauri run tauri:dev",
    "sd:tauri:build": "bun --cwd=apps/spacedrive/apps/tauri run tauri:build",
    "sd:daemon": "cargo run -p sd-core --bin sd-daemon",
    "sd:cli": "cargo run -p sd-cli --bin sd-cli --",
    "sd:test:rust": "bun apps/spacedrive/scripts/cargo.ts test",
    "doctor": "bun scripts/ui.ts doctor",
    "theme": "bun scripts/ui.ts theme",
    "migrate": "bun scripts/ui.ts migrate",
    "devtools": "bun scripts/ui.ts devtools",
    "ui:mcp": "bun scripts/ui.ts mcp serve",
    "react": "bun scripts/react-bun.ts",
    "fleet:status": "bun scripts/fleet.ts status",
    "fleet:sync": "bun scripts/fleet.ts sync",
    "fleet:inventory": "bun scripts/fleet.ts inventory",
    "build": "bun scripts/build.ts check",
    "build:release": "bun scripts/build.ts release",
    "aot:check": "bun check --aot scripts/ui.ts",
    "aot:build": "bun build --compile --aot --outfile dist/yolo-ui scripts/ui.ts",
    "test": "bun test && bun scripts/test.ts",
    "test:rust": "bun scripts/test.ts",
    "optimize": "bun scripts/optimize.ts",
    "n2b:audit": "bun scripts/migrate-bun.ts",
    "fmt": "bun fmt scripts tests",
    "lint": "bun lint scripts tests",
    "check": "bun check"
  }
}
