{
	"name": "@sd/tauri",
	"private": true,
	"version": "2.0.0-alpha.2",
	"type": "module",
	"engines": {
		"bun": ">=1.3.0"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:with-daemon": "bun ./scripts/dev-with-daemon.ts",
		"build": "vite build",
		"build:daemon": "bash -c 'cargo build --bin sd-daemon --manifest-path ../../../../Cargo.toml ${CARGO_BUILD_TARGET:+--target $CARGO_BUILD_TARGET}'",
		"build:daemon:release": "bash -c 'cargo build --release --bin sd-daemon --manifest-path ../../../../Cargo.toml ${CARGO_BUILD_TARGET:+--target $CARGO_BUILD_TARGET}'",
		"preview": "vite preview",
		"typecheck": "tsc -b",
		"tauri": "tauri",
		"daemon:sidecar": "bun ./scripts/ensure-daemon-sidecar.ts",
		"tauri:dev": "bun run daemon:sidecar && tauri dev",
		"tauri:dev:no-watch": "bun run daemon:sidecar && tauri dev --no-watch",
		"tauri:build": "bun run daemon:sidecar && tauri build && bun ./scripts/fix-daemon-entitlements.ts"
	},
	"dependencies": {
		"@phosphor-icons/react": "^2.1.0",
		"@sd/assets": "workspace:*",
		"@sd/interface": "workspace:*",
		"@sd/ts-client": "workspace:*",
		"@spacedrive/primitives": "^0.2.3",
		"@tauri-apps/api": "3.0.0-alpha.3",
		"@tauri-apps/plugin-dialog": "3.0.0-alpha.4",
		"@tauri-apps/plugin-fs": "3.0.0-alpha.3",
		"@tauri-apps/plugin-opener": "3.0.0-alpha.3",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-router-dom": "=6.20.1",
		"react-scan": "^0.4.3"
	},
	"devDependencies": {
		"@headlessui/tailwindcss": "^0.2.0",
		"@spacedrive/tokens": "^0.2.3",
		"@tailwindcss/forms": "^0.5.7",
		"@tailwindcss/typography": "^0.5.10",
		"@tailwindcss/vite": "^4.1.0",
		"@tauri-apps/cli": "3.0.0-alpha.5",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react-swc": "^4.0.0",
		"sass": "^1.107.1",
		"tailwindcss": "^4.1.0",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.6.2",
		"vite": "^5.4.9"
	}
}
