# Path to your ComfyUI installation (optional, for image/video generation)
# COMFYUI_PATH=C:\path\to\your\ComfyUI

# Yolo local inference (llama.cpp servers from yolo-ai: `bun scripts/yolo-sync.ts models serve chat`).
# Comma list of name=baseUrl; loopback only. Each one is added once as an OpenAI-compatible provider entry at startup.
# VITE_YOLO_LOCAL_LLM_ENDPOINTS=local-qwen-small=http://127.0.0.1:8083/v1,local-qwen-coder=http://127.0.0.1:8082/v1,local-qwen=http://127.0.0.1:8081/v1
# The dev server health probe also checks these (same variable name without the VITE_ prefix works too).
# YOLO_LOCAL_LLM_ENDPOINTS=
