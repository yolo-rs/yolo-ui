{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@kit/*": ["../../.kits/rosegriffon/packages/rg-ui/src/*"]
    }
  },
  "include": ["*.tsx", "../../shared/*.ts"]
}
