{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yolo-aphrody-com",
  "compatibility_date": "2026-11-01",
  // Static export of yolo-rs/yolo-hub (`yolo-hub --export dist/yolo-aphrody-com`).
  // `_headers` and `_redirects` in that directory carry the CSP and legacy redirects.
  "assets": {
    "directory": "./dist/yolo-aphrody-com",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "yolo.aphrody.com", "custom_domain": true }]
}
