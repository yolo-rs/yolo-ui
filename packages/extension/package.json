{
  "name": "@aphrody/dioxus-vscode-ext",
  "displayName": "Yolo UI / Dioxus",
  "description": "VS Code extension for Yolo UI & Dioxus RSX formatting and HTML conversion",
  "version": "0.8.0-alpha.3",
  "publisher": "aphrody-labs",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "icon": "static/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/aphrody-labs/yolo-ui"
  },
  "engines": {
    "vscode": "^1.95.0",
    "bun": ">=1.4.4"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:rust"
  ],
  "main": "./out/main.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "extension.htmlToDioxusRsx",
        "title": "Dioxus: Convert HTML to RSX"
      },
      {
        "command": "extension.htmlToDioxusComponent",
        "title": "Dioxus: Convert HTML to Component"
      },
      {
        "command": "extension.formatRsx",
        "title": "Dioxus: Format RSX"
      },
      {
        "command": "extension.formatRsxDocument",
        "title": "Dioxus: Format RSX Document"
      }
    ],
    "configuration": {
      "properties": {
        "dioxus.formatOnSave": {
          "type": [
            "string"
          ],
          "default": "followFormatOnSave",
          "enum": [
            "followFormatOnSave",
            "enabled",
            "disabled"
          ],
          "enumItemLabels": [
            "Follow the normal formatOnSave config",
            "Enabled",
            "Disabled"
          ],
          "enumDescriptions": [
            "Only format Rsx when saving files if the editor.formatOnSave config is enabled",
            "Always format Rsx when a Rust file is saved",
            "Never format Rsx when a file is saved"
          ],
          "description": "Format RSX when a file is saved."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run build",
    "vsix": "bunx @vscode/vsce package",
    "build-wasm": "cargo build --target wasm32-unknown-unknown --release && cp ../../target/wasm32-unknown-unknown/release/dioxus_ext.wasm pkg/",
    "bind-wasm": "wasm-bindgen --out-dir=pkg --target=web --omit-default-module-path --omit-imports pkg/dioxus_ext.wasm",
    "bundle": "bun build ./src/main.ts --outdir ./out --target node --external vscode --sourcemap=external",
    "build-base": "bun run build-wasm && bun run bind-wasm && bun run bundle",
    "package": "bun build ./src/main.ts --outdir ./out --target node --external vscode --minify",
    "check": "bun check",
    "build": "bun run build-base",
    "watch": "bun build ./src/main.ts --outdir ./out --target node --external vscode --watch",
    "lint": "bun lint ./src",
    "fmt": "bun fmt --check ./src",
    "fix": "bun fmt ./src && bun lint --fix ./src",
    "pretest": "bun check && bun run build",
    "test": "TEST_VARIABLE=test bun ./out/tests/runTests.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "dioxus-ext": "./pkg"
  }
}
