{
  "name": "@yolo-rs/fullstack",
  "version": "0.8.0",
  "description": "Yolo Fullstack: a Bun-native replacement for Next.js (App Router, React Server Components, server actions, streaming SSR, static generation) on Bun.build + Bun.serve, with next.config, Turbopack config, next/font, next/image CDN, TanStack Router/Query and Dioxus 0.8 bridges",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.4",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yolo-rs/yolo-ui.git",
    "directory": "packages/yolo-fullstack"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "bin": {
    "yolo-fullstack": "./bin/yolo-fullstack.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app/index.ts",
    "./config": "./src/config/index.ts",
    "./font": "./src/font/index.ts",
    "./font/google": "./src/font/google.ts",
    "./font/local": "./src/font/local.ts",
    "./image": "./src/image/index.ts",
    "./tanstack": "./src/tanstack/index.ts",
    "./tanstack/query": "./src/tanstack/query.tsx",
    "./tanstack/query-client": "./src/tanstack/query-client.tsx",
    "./dioxus": "./src/dioxus/index.ts",
    "./migrate": "./src/migrate/index.ts",
    "./next/link": "./src/app/link.tsx",
    "./next/navigation": {
      "react-server": "./src/app/navigation.server.ts",
      "default": "./src/app/navigation.ts"
    },
    "./next/headers": "./src/app/headers.ts",
    "./next/server": "./src/app/server.ts",
    "./next/cache": "./src/app/cache.ts",
    "./next/image": "./src/app/image.tsx",
    "./next/dynamic": "./src/app/dynamic.tsx",
    "./next/script": "./src/app/script.tsx",
    "./next/constants": "./src/app/constants.ts",
    "./next/config": "./src/app/runtime-config.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test",
    "check": "bun check --no-script",
    "lint": "bun lint --no-script src tests bin",
    "fmt": "bun fmt --no-script src tests bin"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "@tanstack/react-router": ">=1.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-server-dom-parcel": ">=19.0.0",
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.130.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-server-dom-parcel": "^19.2.0"
  }
}
