    "./rules": "./src/rules.ts",
    "./turbopack": "./src/turbopack.ts",
    "./plugin": "./src/plugin.ts",
    "./build": "./src/build.ts",
    "./cdn": "./src/cdn.ts",
    "./migrate": "./src/migrate.ts",
    "./rsc-engine": "./src/rsc-engine.ts",
    "./server": "./src/server.ts",
    "./rsc": "./src/rsc.ts",
    "./actions": "./src/actions.ts",
    "./cache": "./src/cache.ts",
    "./headers": "./src/headers.ts",
    "./navigation": "./src/navigation.ts",
    "./link": "./src/link.ts",
    "./image": "./src/image.ts",
    "./fonts": "./src/fonts.ts",
    "./og": "./src/og.ts",
    "./tanstack": "./src/tanstack.ts",
    "./shims/*": "./src/shims/*.ts",
    "./cli": "./src/cli.ts"
